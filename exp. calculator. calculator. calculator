int main(void) {
    char line[MAX_INPUT];
    int choice;

    puts("=========================================");
    puts("   EXPRESSION CALCULATOR  (Team Motion)");
    puts("   Infix | Postfix | Prefix  using Stacks");
    puts("=========================================");

    for (;;) {
        puts("\n 1. Evaluate infix expression");
        puts(" 2. Evaluate infix with step-by-step trace");
        puts(" 3. Evaluate postfix expression");
        puts(" 4. Evaluate prefix expression");
        puts(" 5. View history");
        puts(" 6. Clear history");
        puts(" 7. Run built-in tests");
        puts(" 8. Help (precedence table & algorithm)");
        puts(" 9. Exit");
        if (!readLine("Choose: ", line, sizeof line)) break;
        choice = (int)strtol(line, NULL, 10);

        switch (choice) {
            case 1: doInfix(0); break;
            case 2: doInfix(1); break;
            case 3: doDirect(0); break;
            case 4: doDirect(1); break;
            case 5: showHistory(); break;
            case 6: clearHistory(); puts("History cleared."); break;
            case 7: runTests(); break;
            case 8: showHelp(); break;
            case 9: clearHistory(); puts("Goodbye!"); return 0;
            default: puts("Please choose a number from 1 to 9.");
        }
    }

    clearHistory();
    return 0;
}
