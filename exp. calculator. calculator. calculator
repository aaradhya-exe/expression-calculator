/*
 * EXPRESSION CALCULATOR  -  DSA Project (Team Motion)
 * Infix, Postfix & Prefix expression evaluation using Stacks
 * ---------------------------------------------------------------------
 * Workflow (as per project presentation):
 *   Input -> Tokenize -> Convert (infix -> postfix) -> Evaluate -> Output
 *
 * Features:
 *   - Operators: + - * / % ^  and nested parentheses
 *   - Correct precedence & associativity (^ is right-to-left)
 *   - Multi-digit numbers, decimals and negative values (unary minus)
 *   - Detects invalid / unbalanced / malformed expressions (no crashes)
 *   - Shows the intermediate POSTFIX and PREFIX forms
 *   - Step-by-step trace tables (conversion and evaluation)
 *   - Evaluate a ready-made postfix or prefix expression directly
 *   - Linked-list history
 *   - Built-in unit tests (nested & malformed expressions)
 *
 * Data structures: array-based stacks (operator stack, operand stack,
 * string stack) + singly linked list (history).
 *
 * Compile: gcc expression_calculator.c -o expr_calc -lm
 * Run    : ./expr_calc
 */

#include <ctype.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_TOK 256
#define MAX_INPUT 512
#define MAX_EXPR_LEN 200
#define MAX_STR 1024
#define MAX_STR_STACK 128
#define ERR_SZ 128

/* ===================== Tokens ===================== */

typedef enum { T_NUM, T_OP, T_LP, T_RP } TokType;

typedef struct {
    TokType type;
    double value; /* for T_NUM */
    char op;      /* for T_OP: + - * / % ^ and '~' (unary minus) */
} Token;

/* ===================== Stacks (array based, LIFO) ===================== */

typedef struct { char items[MAX_TOK]; int top; } OpStack;
typedef struct { double items[MAX_TOK]; int top; } NumStack;
typedef struct { char items[MAX_STR_STACK][MAX_STR]; int top; } StrStack;

static StrStack str_stack; /* static: too large for the call stack */

/* ===================== History (linked list) ===================== */

typedef struct HistoryNode {
    char infix[MAX_INPUT];
    char postfix[MAX_STR];
    char prefix[MAX_STR];
    double result;
    struct HistoryNode *next;
} HistoryNode;

static HistoryNode *history_head = NULL;

/* ===================== Formatting helpers ===================== */

static void fmt(double v, char *buf, size_t sz) {
    if (v == 0) v = 0.0; /* avoid printing "-0" */
    if (fabs(v) < 1e15 && v == floor(v)) snprintf(buf, sz, "%.0f", v);
    else snprintf(buf, sz, "%.10g", v);
}

static void tokStr(const Token *t, char *buf, size_t sz) {
    switch (t->type) {
        case T_NUM: fmt(t->value, buf, sz); break;
        case T_OP:  snprintf(buf, sz, "%c", t->op); break;
        case T_LP:  snprintf(buf, sz, "("); break;
        case T_RP:  snprintf(buf, sz, ")"); break;
    }
}

static void tokensToString(const Token *t, int n, char *buf, size_t sz) {
    size_t len = 0;
    buf[0] = '\0';
    if (n == 0) { snprintf(buf, sz, "-"); return; }
    for (int i = 0; i < n; i++) {
        char piece[40];
        size_t pl;
        tokStr(&t[i], piece, sizeof piece);
        pl = strlen(piece);
        if (len + pl + 2 >= sz) break;
        if (i) buf[len++] = ' ';
        memcpy(buf + len, piece, pl);
        len += pl;
        buf[len] = '\0';
    }
}

static void opStackStr(const OpStack *s, char *buf, size_t sz) {
    size_t len = 0;
    buf[0] = '\0';
    if (s->top < 0) { snprintf(buf, sz, "-"); return; }
    for (int i = 0; i <= s->top && len + 3 < sz; i++) {
        if (i) buf[len++] = ' ';
        buf[len++] = s->items[i];
        buf[len] = '\0';
    }
}

static void numStackStr(const NumStack *s, char *buf, size_t sz) {
    size_t len = 0;
    len += (size_t)snprintf(buf + len, sz - len, "[");
    for (int i = 0; i <= s->top; i++) {
        char nb[40];
        if (len + 40 >= sz) { snprintf(buf + len, sz - len, ", ..."); len = strlen(buf); break; }
        fmt(s->items[i], nb, sizeof nb);
        len += (size_t)snprintf(buf + len, sz - len, "%s%s", i ? ", " : "", nb);
    }
    if (len + 2 < sz) snprintf(buf + len, sz - len, "]");
}

/* ===================== Operators ===================== */
/*
 * Precedence (higher binds tighter):
 *   + -        : 1   left to right
 *   * / %      : 2   left to right
 *   ~ (unary -): 3   right to left (prefix)
 *   ^          : 4   right to left   (so -2^2 = -(2^2) = -4)
 */
static int precedence(char op) {
    switch (op) {
        case '+': case '-': return 1;
        case '*': case '/': case '%': return 2;
        case '~': return 3;
        case '^': return 4;
        default: return 0;
    }
}

static int rightAssoc(char op) { return op == '^' || op == '~'; }

static int applyBinary(char op, double a, double b, double *r, char *err) {
    switch (op) {
        case '+': *r = a + b; break;
        case '-': *r = a - b; break;
        case '*': *r = a * b; break;
        case '/':
            if (b == 0) { strcpy(err, "Division by zero"); return 0; }
            *r = a / b; break;
        case '%':
            if (b == 0) { strcpy(err, "Modulo by zero"); return 0; }
            *r = fmod(a, b); break;
        case '^':
            if (a == 0 && b < 0) { strcpy(err, "Zero cannot be raised to a negative power"); return 0; }
            *r = pow(a, b); break;
        default:
            snprintf(err, ERR_SZ, "Unknown operator '%c'", op);
            return 0;
    }
    if (!isfinite(*r)) {
        strcpy(err, "Result is not a finite number (overflow or invalid power)");
        return 0;
    }
    return 1;
}

/* ===================== Step 1: Tokenizer (infix) ===================== */

static int addTok(Token *t, int *n, TokType type, double v, char op, char *err) {
    if (*n >= MAX_TOK) { strcpy(err, "Expression is too long"); return 0; }
    t[*n].type = type; t[*n].value = v; t[*n].op = op;
    (*n)++;
    return 1;
}

/*
 * Splits the infix string into numbers, operators and brackets and validates
 * the order of tokens at the same time (operand / operator alternation).
 * A '-' where an operand is expected becomes the unary-minus operator '~',
 * which is how negative numbers are told apart from subtraction.
 */
static int tokenizeInfix(const char *s, Token *t, int *count, char *err) {
    int n = 0, expectOperand = 1;
    const char *p = s;

    while (*p) {
        if (isspace((unsigned char)*p)) { p++; continue; }

        if (isdigit((unsigned char)*p) || *p == '.') {
            char *end;
            double v;
            if (!expectOperand) { strcpy(err, "Missing operator between two operands"); return 0; }
            v = strtod(p, &end);
            if (end == p) { strcpy(err, "Invalid number"); return 0; }
            if (!addTok(t, &n, T_NUM, v, 0, err)) return 0;
            p = end;
            expectOperand = 0;
        } else if (*p == '(') {
            if (!expectOperand) { strcpy(err, "Missing operator before '('"); return 0; }
            if (!addTok(t, &n, T_LP, 0, '(', err)) return 0;
            p++;
        } else if (*p == ')') {
            if (expectOperand) { strcpy(err, "Missing operand before ')' (empty brackets or dangling operator)"); return 0; }
            if (!addTok(t, &n, T_RP, 0, ')', err)) return 0;
            p++;
        } else if (strchr("+-*/%^", *p)) {
            if (expectOperand) {
                if (*p == '-') { if (!addTok(t, &n, T_OP, 0, '~', err)) return 0; }
                else if (*p == '+') { /* unary plus: ignore */ }
                else { snprintf(err, ERR_SZ, "Operator '%c' has no left operand", *p); return 0; }
                p++;
            } else {
                if (!addTok(t, &n, T_OP, 0, *p, err)) return 0;
                p++;
                expectOperand = 1;
            }
        } else {
            snprintf(err, ERR_SZ, "Invalid character '%c'", *p);
            return 0;
        }
    }

    if (expectOperand) {
        strcpy(err, n == 0 ? "Empty expression" : "Expression ends with an operator (missing operand)");
        return 0;
    }
    *count = n;
    return 1;
}

/* ===================== Step 2: Infix -> Postfix (shunting-yard) ===================== */

static int infixToPostfix(const Token *in, int n, Token *out, int *outN, char *err, int trace) {
    OpStack st;
    int o = 0;
    st.top = -1;

    if (trace) {
        printf("\n%-7s | %-26s | %-18s | %s\n", "Token", "Action", "Operator Stack", "Output");
        printf("--------+----------------------------+--------------------+-----------------\n");
    }

    for (int i = 0; i < n; i++) {
        Token t = in[i];
        char action[64] = "", tb[40], sb[128], ob[256];

        if (t.type == T_NUM) {
            out[o++] = t;
            strcpy(action, "Operand -> output");
        } else if (t.type == T_LP) {
            st.items[++st.top] = '(';
            strcpy(action, "Push boundary");
        } else if (t.type == T_RP) {
            while (st.top >= 0 && st.items[st.top] != '(') {
                out[o].type = T_OP; out[o].op = st.items[st.top--]; out[o].value = 0; o++;
            }
            if (st.top < 0) { strcpy(err, "Unbalanced brackets: extra ')'"); return 0; }
            st.top--; /* discard '(' */
            strcpy(action, "Pop till '('");
        } else { /* operator */
            if (t.op == '~') {
                st.items[++st.top] = '~'; /* prefix operator: nothing to pop */
                strcpy(action, "Push unary minus");
            } else {
                int popped = 0;
                while (st.top >= 0 && st.items[st.top] != '(' &&
                       (precedence(st.items[st.top]) > precedence(t.op) ||
                        (precedence(st.items[st.top]) == precedence(t.op) && !rightAssoc(t.op)))) {
                    out[o].type = T_OP; out[o].op = st.items[st.top--]; out[o].value = 0; o++;
                    popped++;
                }
                st.items[++st.top] = t.op;
                strcpy(action, popped ? "Pop >= prec., push" : "Push operator");
            }
        }

        if (trace) {
            tokStr(&t, tb, sizeof tb);
            opStackStr(&st, sb, sizeof sb);
            tokensToString(out, o, ob, sizeof ob);
            printf("%-7s | %-26s | %-18s | %s\n", tb, action, sb, ob);
        }
    }

    while (st.top >= 0) {
        if (st.items[st.top] == '(') { strcpy(err, "Unbalanced brackets: missing ')'"); return 0; }
        out[o].type = T_OP; out[o].op = st.items[st.top--]; out[o].value = 0; o++;
    }

    if (trace) {
        char ob[256];
        tokensToString(out, o, ob, sizeof ob);
        printf("%-7s | %-26s | %-18s | %s\n", "end", "Pop remaining", "-", ob);
    }
    *outN = o;
    return 1;
}

/* ===================== Step 3: Postfix evaluation (operand stack) ===================== */

static int evalPostfix(const Token *pf, int n, double *res, char *err, int trace) {
    NumStack st;
    st.top = -1;

    if (n == 0) { strcpy(err, "Empty postfix expression"); return 0; }
    if (trace) {
        printf("\n%-7s | %-34s | %s\n", "Token", "Action", "Operand Stack");
        printf("--------+------------------------------------+------------------\n");
    }

    for (int i = 0; i < n; i++) {
        char action[128] = "", tb[40], sb[256], x[40], y[40], z[40];

        if (pf[i].type == T_NUM) {
            if (st.top >= MAX_TOK - 1) { strcpy(err, "Operand stack overflow"); return 0; }
            st.items[++st.top] = pf[i].value;
            fmt(pf[i].value, x, sizeof x);
            snprintf(action, sizeof action, "Push %s", x);
        } else if (pf[i].type == T_OP && pf[i].op == '~') {
            double a, r;
            if (st.top < 0) { strcpy(err, "Not enough operands for unary minus"); return 0; }
            a = st.items[st.top--];
            r = -a;
            st.items[++st.top] = r;
            fmt(a, x, sizeof x); fmt(r, y, sizeof y);
            snprintf(action, sizeof action, "neg %s -> push %s", x, y);
        } else if (pf[i].type == T_OP) {
            double a, b, r;
            if (st.top < 1) { snprintf(err, ERR_SZ, "Not enough operands for operator '%c'", pf[i].op); return 0; }
            b = st.items[st.top--];
            a = st.items[st.top--];
            if (!applyBinary(pf[i].op, a, b, &r, err)) return 0;
            st.items[++st.top] = r;
            fmt(a, x, sizeof x); fmt(b, y, sizeof y); fmt(r, z, sizeof z);
            snprintf(action, sizeof action, "%s %c %s -> push %s", x, pf[i].op, y, z);
        } else {
            strcpy(err, "Brackets are not allowed in postfix/prefix form");
            return 0;
        }

        if (trace) {
            tokStr(&pf[i], tb, sizeof tb);
            numStackStr(&st, sb, sizeof sb);
            printf("%-7s | %-34s | %s\n", tb, action, sb);
        }
    }

    if (st.top != 0) {
        snprintf(err, ERR_SZ, "Malformed expression (%d values left on the stack)", st.top + 1);
        return 0;
    }
    *res = st.items[0];
    return 1;
}

/* Prefix evaluation: scan RIGHT to LEFT with one operand stack. */
static int evalPrefix(const Token *pf, int n, double *res, char *err, int trace) {
    NumStack st;
    st.top = -1;

    if (n == 0) { strcpy(err, "Empty prefix expression"); return 0; }
    if (trace) {
        printf("\n%-7s | %-34s | %s\n", "Token", "Action", "Operand Stack");
        printf("--------+------------------------------------+------------------\n");
    }

    for (int i = n - 1; i >= 0; i--) {
        char action[128] = "", tb[40], sb[256], x[40], y[40], z[40];

        if (pf[i].type == T_NUM) {
            if (st.top >= MAX_TOK - 1) { strcpy(err, "Operand stack overflow"); return 0; }
            st.items[++st.top] = pf[i].value;
            fmt(pf[i].value, x, sizeof x);
            snprintf(action, sizeof action, "Push %s", x);
        } else if (pf[i].type == T_OP && pf[i].op == '~') {
            double a, r;
            if (st.top < 0) { strcpy(err, "Not enough operands for unary minus"); return 0; }
            a = st.items[st.top--];
            r = -a;
            st.items[++st.top] = r;
            fmt(a, x, sizeof x); fmt(r, y, sizeof y);
            snprintf(action, sizeof action, "neg %s -> push %s", x, y);
        } else if (pf[i].type == T_OP) {
            double a, b, r;
            if (st.top < 1) { snprintf(err, ERR_SZ, "Not enough operands for operator '%c'", pf[i].op); return 0; }
            a = st.items[st.top--]; /* first operand is on top */
            b = st.items[st.top--];
            if (!applyBinary(pf[i].op, a, b, &r, err)) return 0;
            st.items[++st.top] = r;
            fmt(a, x, sizeof x); fmt(b, y, sizeof y); fmt(r, z, sizeof z);
            snprintf(action, sizeof action, "%s %c %s -> push %s", x, pf[i].op, y, z);
        } else {
            strcpy(err, "Brackets are not allowed in postfix/prefix form");
            return 0;
        }

        if (trace) {
            tokStr(&pf[i], tb, sizeof tb);
            numStackStr(&st, sb, sizeof sb);
            printf("%-7s | %-34s | %s\n", tb, action, sb);
        }
    }

    if (st.top != 0) {
        snprintf(err, ERR_SZ, "Malformed expression (%d values left on the stack)", st.top + 1);
        return 0;
    }
    *res = st.items[0];
    return 1;
}

/* ===================== Postfix -> Prefix (string stack) ===================== */

static int postfixToPrefix(const Token *pf, int n, char *out, size_t osz, char *err) {
    char tmp[MAX_STR];
    str_stack.top = -1;

    for (int i = 0; i < n; i++) {
        if (pf[i].type == T_NUM) {
            if (str_stack.top >= MAX_STR_STACK - 1) { strcpy(err, "Expression too complex for prefix conversion"); return 0; }
            fmt(pf[i].value, str_stack.items[++str_stack.top], MAX_STR);
        } else if (pf[i].op == '~') {
            if (str_stack.top < 0) { strcpy(err, "Malformed expression"); return 0; }
            snprintf(tmp, sizeof tmp, "~ %s", str_stack.items[str_stack.top]);
            strcpy(str_stack.items[str_stack.top], tmp);
        } else {
            if (str_stack.top < 1) { strcpy(err, "Malformed expression"); return 0; }
            snprintf(tmp, sizeof tmp, "%c %s %s", pf[i].op,
                     str_stack.items[str_stack.top - 1], str_stack.items[str_stack.top]);
            str_stack.top--;
            strcpy(str_stack.items[str_stack.top], tmp);
        }
    }
    if (str_stack.top != 0) { strcpy(err, "Malformed expression"); return 0; }
    snprintf(out, osz, "%s", str_stack.items[0]);
    return 1;
}

/* ===================== Full pipeline for an infix expression ===================== */

static int calculateInfix(const char *expr, double *res, char *postfixStr, size_t psz,
                          char *prefixStr, size_t xsz, char *err, int trace) {
    Token in[MAX_TOK], pf[MAX_TOK];
    int n = 0, m = 0;

    if (strlen(expr) > MAX_EXPR_LEN) {
        snprintf(err, ERR_SZ, "Expression too long (max %d characters)", MAX_EXPR_LEN);
        return 0;
    }
    if (!tokenizeInfix(expr, in, &n, err)) return 0;

    if (trace) {
        char tb[512];
        tokensToString(in, n, tb, sizeof tb);
        printf("\n[Tokenize] %s\n", tb);
        printf("\n[Convert: Infix -> Postfix]");
    }
    if (!infixToPostfix(in, n, pf, &m, err, trace)) return 0;
    tokensToString(pf, m, postfixStr, psz);

    if (!postfixToPrefix(pf, m, prefixStr, xsz, err)) return 0;

    if (trace) printf("\n[Evaluate: Postfix]");
    return evalPostfix(pf, m, res, err, trace);
}

/* ===================== Direct postfix / prefix input ===================== */

static int tokenizeSpaced(const char *s, Token *t, int *count, char *err) {
    char buf[MAX_INPUT];
    char *tok;
    int n = 0;

    if (strlen(s) > MAX_EXPR_LEN) {
        snprintf(err, ERR_SZ, "Expression too long (max %d characters)", MAX_EXPR_LEN);
        return 0;
    }
    snprintf(buf, sizeof buf, "%s", s);
    for (tok = strtok(buf, " \t\r\n"); tok; tok = strtok(NULL, " \t\r\n")) {
        size_t len = strlen(tok);
        if (len == 1 && strchr("+-*/%^~", tok[0])) {
            if (!addTok(t, &n, T_OP, 0, tok[0], err)) return 0;
        } else {
            char *end;
            double v = strtod(tok, &end);
            if (*end || end == tok) { snprintf(err, ERR_SZ, "Invalid token '%.30s'", tok); return 0; }
            if (!addTok(t, &n, T_NUM, v, 0, err)) return 0;
        }
    }
    if (n == 0) { strcpy(err, "Empty expression"); return 0; }
    *count = n;
    return 1;
}

/* ===================== History ===================== */

static void addHistory(const char *infix, const char *postfix, const char *prefix, double result) {
    HistoryNode *node = malloc(sizeof(*node));
    if (!node) return;
    snprintf(node->infix, sizeof node->infix, "%s", infix);
    snprintf(node->postfix, sizeof node->postfix, "%s", postfix);
    snprintf(node->prefix, sizeof node->prefix, "%s", prefix);
    node->result = result;
    node->next = history_head;
    history_head = node;
}

static void showHistory(void) {
    int i = 1;
    char rb[64];
    if (!history_head) { puts("No calculations saved yet."); return; }
    puts("\n--- History (latest first) ---");
    for (HistoryNode *h = history_head; h; h = h->next) {
        fmt(h->result, rb, sizeof rb);
        printf("%d. %s = %s\n     postfix: %s\n     prefix : %s\n", i++, h->infix, rb, h->postfix, h->prefix);
    }
}

static void clearHistory(void) {
    while (history_head) {
        HistoryNode *next = history_head->next;
        free(history_head);
        history_head = next;
    }
}

/* ===================== Menu actions ===================== */

static int readLine(const char *prompt, char *buf, size_t sz) {
    printf("%s", prompt);
    if (!fgets(buf, (int)sz, stdin)) return 0;
    buf[strcspn(buf, "\r\n")] = '\0';
    return 1;
}

static void doInfix(int trace) {
    char expr[MAX_INPUT], postfix[MAX_STR], prefix[MAX_STR], err[ERR_SZ], rb[64];
    double result;

    if (!readLine("Enter infix expression: ", expr, sizeof expr)) return;
    if (calculateInfix(expr, &result, postfix, sizeof postfix, prefix, sizeof prefix, err, trace)) {
        fmt(result, rb, sizeof rb);
        printf("\nInfix   : %s\nPostfix : %s\nPrefix  : %s\nResult  = %s\n", expr, postfix, prefix, rb);
        addHistory(expr, postfix, prefix, result);
    } else {
        printf("\nError: %s\n", err);
    }
}

static void doDirect(int prefixMode) {
    char expr[MAX_INPUT], err[ERR_SZ], rb[64];
    Token t[MAX_TOK];
    int n = 0;
    double result;

    printf("Use spaces between tokens. Unary minus is written as ~ (negative numbers like -5 are fine).\n");
    printf("Example: %s\n", prefixMode ? "+ 3 * 4 - 2 1" : "3 4 2 1 - * +");
    if (!readLine(prefixMode ? "Enter prefix expression : " : "Enter postfix expression: ", expr, sizeof expr)) return;
    if (!tokenizeSpaced(expr, t, &n, err)) { printf("\nError: %s\n", err); return; }
    if (prefixMode ? evalPrefix(t, n, &result, err, 1) : evalPostfix(t, n, &result, err, 1)) {
        fmt(result, rb, sizeof rb);
        printf("\nResult = %s\n", rb);
    } else {
        printf("\nError: %s\n", err);
    }
}

static void showHelp(void) {
    puts("\n================ HELP ================");
    puts("Supported: + - * / % ^  ( )  decimals, negative numbers");
    puts("\n Operator    Precedence   Associativity");
    puts(" ( )         Highest      -");
    puts(" ^           4            Right to Left");
    puts(" ~ (neg -)   3            Right to Left   (unary minus, e.g. -5, -(2+3))");
    puts(" * / %       2            Left to Right");
    puts(" + -         1            Left to Right");
    puts("\nAlgorithm (infix -> postfix):");
    puts(" 1. Operand            -> append to output");
    puts(" 2. '('                -> push on operator stack");
    puts(" 3. ')'                -> pop to output until '(' ; discard both");
    puts(" 4. Operator           -> pop >= precedence to output, then push");
    puts(" 5. End of input       -> pop all remaining operators to output");
    puts("\nPostfix evaluation: number -> push; operator -> pop b, pop a, push (a op b).");
    puts("Note: -2^2 = -4 because ^ binds tighter than unary minus; 2^3^2 = 512.");
    puts("======================================");
}

/* ===================== Built-in tests ===================== */

typedef struct { const char *expr; int valid; double expected; } TestCase;

static void runTests(void) {
    static const TestCase tests[] = {
        {"3 + 4 * ( 2 - 1 )", 1, 7},     {"(2+3)*(4-1)", 1, 15},
        {"2^3^2", 1, 512},               {"-2^2", 1, -4},
        {"2^-1", 1, 0.5},                {"10/4", 1, 2.5},
        {"((1+2)*3)-4", 1, 5},           {"7%3", 1, 1},
        {"-(2+3)*2", 1, -10},            {"12 + 34 * 5 - 6 / 3", 1, 180},
        {"2--3", 1, 5},                  {"1.5+2.5", 1, 4},
        {"100/(5*(3+1))", 1, 5},         {"2*(3+(4-1)*2)", 1, 18},
        {"(2+3", 0, 0},                  {"2+3)", 0, 0},
        {"2 * * 3", 0, 0},               {"5/0", 0, 0},
        {"", 0, 0},                      {"2 3", 0, 0},
        {"()", 0, 0},                    {"3+", 0, 0},
        {"abc", 0, 0},                   {"2(3)", 0, 0}
    };
    int total = (int)(sizeof tests / sizeof tests[0]), passed = 0;

    puts("\n--- Running built-in tests ---");
    for (int i = 0; i < total; i++) {
        char postfix[MAX_STR], prefix[MAX_STR], err[ERR_SZ] = "", rb[64];
        double r = 0;
        int ok = calculateInfix(tests[i].expr, &r, postfix, sizeof postfix, prefix, sizeof prefix, err, 0);
        int pass = tests[i].valid ? (ok && fabs(r - tests[i].expected) < 1e-9) : !ok;

        if (pass) passed++;
        if (ok) { fmt(r, rb, sizeof rb); snprintf(err, sizeof err, "= %s", rb); }
        printf("[%s] \"%s\"  ->  %s\n", pass ? "PASS" : "FAIL", tests[i].expr, ok ? err : err);
    }
    printf("\n%d / %d tests passed.\n", passed, total);
}

