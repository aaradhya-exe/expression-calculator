/* ---------------- Command handling ---------------- */

/* Returns 1 if line matched a command (handled), 0 otherwise. */
static int handleCommand(const char *line, int *quit) {
    char cmd[32];
    const char *rest;
    int len = 0;
    const char *p = line;

    while (*p && !isspace((unsigned char)*p) && len < 31) cmd[len++] = (char)tolower((unsigned char)*p++);
    cmd[len] = '\0';
    if (*p && !isspace((unsigned char)*p)) return 0; /* word too long */
    while (isspace((unsigned char)*p)) p++;
    rest = p;

    if (!strcmp(cmd, "exit") || !strcmp(cmd, "quit") || !strcmp(cmd, "q")) { *quit = 1; return 1; }
    if (!strcmp(cmd, "help") || !strcmp(cmd, "?")) { showHelp(); return 1; }
    if (!strcmp(cmd, "history")) { showHistory(); return 1; }
    if (!strcmp(cmd, "clearhistory")) { clearHistory(); puts("History cleared."); return 1; }
    if (!strcmp(cmd, "save")) { saveHistory(); return 1; }
    if (!strcmp(cmd, "deg") && !*rest) { degree_mode = 1; puts("Angle mode: DEGREES"); return 1; }
    if (!strcmp(cmd, "rad") && !*rest) { degree_mode = 0; puts("Angle mode: RADIANS"); return 1; }
    if (!strcmp(cmd, "mode")) { printf("Angle mode: %s\n", degree_mode ? "DEGREES" : "RADIANS"); return 1; }
    if (!strcmp(cmd, "m+") || !strcmp(cmd, "m-")) { doMemory(cmd, rest); return 1; }
    if (!strcmp(cmd, "mr")) { printf("M = "); printNumber(memory_value); putchar('\n'); last_answer = memory_value; return 1; }
    if (!strcmp(cmd, "mc")) { memory_value = 0; puts("Memory cleared."); return 1; }
    if (!strcmp(cmd, "vars")) {
        char b[64];
        if (!var_count) puts("No variables defined. Try: x = 10");
        for (int i = 0; i < var_count; i++) { formatNumber(vars[i].value, b, sizeof b); printf("%s = %s\n", vars[i].name, b); }
        return 1;
    }
    if (!strcmp(cmd, "base")) { doBase(rest); return 1; }
    if (!strcmp(cmd, "convert")) { doConvert(rest); return 1; }
    if (!strcmp(cmd, "units")) { showUnits(); return 1; }
    if (!strcmp(cmd, "quad")) { doQuad(rest); return 1; }
    if (!strcmp(cmd, "linear")) { doLinear(rest); return 1; }
    if (!strcmp(cmd, "emi")) { doEmi(rest); return 1; }
    if (!strcmp(cmd, "si")) { doInterest(rest, 0); return 1; }
    if (!strcmp(cmd, "ci")) { doInterest(rest, 1); return 1; }
    return 0;
}

/* Detects "name = expression". Returns 1 if it is an assignment. */
static int tryAssignment(const char *line) {
    char name[NAME_LEN];
    const char *p = line;
    int len = 0;
    double v;
    char err[96];

    if (!(isalpha((unsigned char)*p) || *p == '_')) return 0;
    while ((isalnum((unsigned char)*p) || *p == '_') && len < NAME_LEN - 1) name[len++] = (char)tolower((unsigned char)*p++);
    name[len] = '\0';
    while (isspace((unsigned char)*p)) p++;
    if (*p != '=' || p[1] == '=') return 0;
    p++;
    if (isReserved(name)) { printf("Error: '%s' is a reserved name.\n", name); return 1; }
    if (!evaluate(p, &v, err, sizeof err)) { printf("Error: %s\n", err); return 1; }
    if (!setVar(name, v)) { puts("Error: too many variables."); return 1; }
    printf("%s = ", name); printNumber(v); putchar('\n');
    last_answer = v;
    return 1;
}

static void trim(char *s) {
    char *start = s;
    size_t n;
    while (isspace((unsigned char)*start)) start++;
    memmove(s, start, strlen(start) + 1);
    n = strlen(s);
    while (n > 0 && isspace((unsigned char)s[n - 1])) s[--n] = '\0';
}

int main(void) {
    char line[MAX_LINE];
    int quit = 0;

    srand((unsigned)time(NULL));
    puts("=====================================");
    puts("      ADVANCED CALCULATOR (C)");
    puts("  Type an expression, or 'help'.");
    puts("=====================================");

    while (!quit) {
        double result;
        char err[96];

        printf("calc> ");
        if (!fgets(line, sizeof line, stdin)) break;
        trim(line);
        if (!*line) continue;

        if (handleCommand(line, &quit)) continue;
        if (tryAssignment(line)) continue;

        if (evaluate(line, &result, err, sizeof err)) {
            printf("= ");
            printNumber(result);
            putchar('\n');
            last_answer = result;
            addHistory(line, result);
        } else {
            printf("Error: %s\n", err);
        }
    }

    clearHistory();
    puts("Goodbye!");
    return 0;
}
